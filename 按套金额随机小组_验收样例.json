{
  "fixture_version": 2,
  "mode": "set_amount_small_v1",
  "purpose": "局部格式与来源金额验收样例；每个案例独立，不是完整号码池，不得据此放宽整批核查。",
  "money_encoding": "canonical_positive_decimal_string",
  "cases": [
    {
      "name": "不同来源同号相加并按最终金额归类",
      "set_amounts": [
        "1",
        "5",
        "2"
      ],
      "records": [
        {
          "position": 1,
          "item_id": 7,
          "set_no": 1,
          "code": "007",
          "amount": "1"
        },
        {
          "position": 2,
          "item_id": 2128,
          "set_no": 3,
          "code": "128",
          "amount": "2"
        },
        {
          "position": 3,
          "item_id": 1007,
          "set_no": 2,
          "code": "007",
          "amount": "5"
        },
        {
          "position": 4,
          "item_id": 2905,
          "set_no": 3,
          "code": "905",
          "amount": "2"
        },
        {
          "position": 5,
          "item_id": 642,
          "set_no": 1,
          "code": "642",
          "amount": "1"
        }
      ],
      "expected_raw_count": 5,
      "expected_distinct_codes": 4,
      "expected_group_amount": "11",
      "expected_code_amounts": {
        "128": "2",
        "642": "1",
        "905": "2",
        "007": "6"
      },
      "expected_body": "642直选1元\n128.905直选2元\n007直选6元\n"
    },
    {
