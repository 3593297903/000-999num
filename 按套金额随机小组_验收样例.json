  "adversarial_cases": [
    {
      "id": "balanced_equal_amount_source_duplicates",
      "name": "边缘汇总全正确但来源编号被平衡替换",
      "set_amounts": [
        "1",
        "1"
      ],
      "build": "建立完整两套，任选合法2～5分组；原始记录字段先全部合法。",
      "replacements": [
        {
          "from_item_id": 1007,
          "to_item_id": 7
        },
        {
          "from_item_id": 8,
          "to_item_id": 1008
        }
      ],
      "dependent_fields": "替换时按新编号更新套号、号码和来源金额；保留group和position。因同号同金额，TXT不变。",
      "must_preserve": [
        "原始总条数2000",
        "每号全局2条",
        "每套总计1000条",
        "每号最终2元",
        "整池2000元"
      ],
      "expected": "REJECT",
      "required_detection": [
        "source_code_cells_exact",
        "standard_records_equal",
        "unique_ids_exact"
      ]
    },
    {
      "id": "balanced_group_amount_swap",
      "name": "每组总额与全局逐号金额均正确但组内错配",
      "set_amounts": [
        "1",
        "5"
      ],
      "leading_groups": [
        [
          7,
          1128
        ],
        [
          1007,
          128
        ]
      ],
      "normal_bodies": [
        "007直选1元\n128直选5元\n",
        "128直选1元\n007直选5元\n"
      ],
      "mutated_bodies": [
        "128直选1元\n007直选5元\n",
        "007直选1元\n128直选5元\n"
      ],
      "remaining": "其余完整ID排除以上4个后合法分组，所有原始记录不变。",
      "must_preserve": [
        "全部原始编号及金额",
        "每组总金额",
        "每号全局累计6元",
        "整池6000元"
      ],
      "expected": "REJECT",
      "required_detection": [
        "group_code_amounts_exact",
        "output_bytes_equal"
      ]
    },
    {
      "id": "reanchored_input_self_consistent",
      "name": "同时改输入和所有文件让包内自洽",
      "trusted_set_amounts": [
        "1",
        "5"
      ],
      "replacement_set_amounts": [
        "1",
        "9"
      ],
      "mutation": "修改request金额，并相应重建明细、TXT和manifest，但保留最初可信输入和request指纹。",
      "expected": "REJECT",
      "forbidden": "不能更新原可信基准或降级为外部导入来回避错误。"
    },
